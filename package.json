{
  "name": "objectly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate:icons": "node scripts/generate-manifest.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "check:descriptions": "node scripts/check-descriptions.mjs",
    "predev": "npm run generate:icons",
    "dev": "vite",
    "prebuild": "npm run generate:icons",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pages:dev": "npm run generate:icons && wrangler pages dev -- npm run dev",
    "subset:fonts": "node scripts/subset-fonts.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "sharp": "^0.35.4",
    "subset-font": "^2.7.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.1.2",
    "wrangler": "^4.28.0"
  }
}
